# Copy this file to .streamlit/secrets.toml for local development
# (create the .streamlit/ folder if it doesn't exist yet).
#
# DO NOT commit the real .streamlit/secrets.toml to git -- add it to
# .gitignore. This example file (with placeholder values) is safe to
# commit; the real one with actual credentials is not.
#
# On Streamlit Community Cloud, you do NOT upload this file -- instead
# paste the same [credentials] block into:
#   App settings -> Secrets

[credentials]
username = "your-username"
password = "your-password"
